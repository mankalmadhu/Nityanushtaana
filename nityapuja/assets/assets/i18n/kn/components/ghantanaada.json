{
  "id": "ghantanaada",
  "blocks": [
    {
      "type": "heading",
      "text": "ಘಂಟಾನಾದ"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಆಗಮಾರ್ಥಂ ತು ದೇವಾನಾಂ ಗಮನಾರ್ಥಂ ತು ರಕ್ಷಸಾಂ । ಕುರ್ವೇ ಘಂಟಾರವಂ ತತ್ರ ದೇವತಾಹ್ವಾನ ಲಾಂಛನಂ ॥"
    },
    {
      "type": "vedic_instruction",
      "text": "ಇತಿ ಘಂಟಾನಾದಂ ಕೃತ್ವಾ ॥"
    }
  ]
}