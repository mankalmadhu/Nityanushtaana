{
  "id": "pratah_arghya_pradana",
  "blocks": [
    {
      "type": "heading",
      "text": "ಅರ್ಘ್ಯ ಪ್ರದಾನ"
    },
    {
      "type": "instruction",
      "text": "(ಪೂರ್ವಾಭಿಮುಖವಾಗಿ ನಿಂತು)"
    },
    {
      "type": "verse_sankalpa",
      "text": "ತತ್ಸವಿತುರ್ವಿಶ್ವಾಮಿತ್ರಸ್ಸವಿತಾಗಾಯತ್ರೀ"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓಂ ತತ್ಸ॑ವಿ॒ತುರ್ವರೇ᳚ಣ್ಯಂ॒ ಭರ್ಗೋ᳚ ದೇ॒ವಸ್ಯ॑ ಧೀಮಹಿ । ಧಿಯೋ॒ ಯೋ ನಃ॑ ಪ್ರಚೋ॒ದಯಾ᳚ತ್ ॥"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ॒ಮಾಪೋ॒ ಜ್ಯೋತೀ॒ರಸೋ॒ಽಮೃತಂ॒ ಬ್ರಹ್ಮ॒ ಭೂರ್ಭುವ॒ಸ್ಸ್ವರೋಂ॥"
    },
    {
      "type": "instruction",
      "text": "(೩ ಬಾರಿ)"
    },
    {
      "type": "verse_sankalpa",
      "text": "ಕಾಲಾತೀತ ದೋಷ ಪ್ರಾಯಶ್ಚಿತ್ತಾರ್ಥಂ ಅರ್ಘ್ಯ ಪ್ರದಾನಂ ಕರಿಷ್ಯೇ ।"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓಂ ತತ್ಸ॑ವಿ॒ತುರ್ವರೇ᳚ಣ್ಯಂ॒ ಭರ್ಗೋ᳚ ದೇ॒ವಸ್ಯ॑ ಧೀಮಹಿ । ಧಿಯೋ॒ ಯೋ ನಃ॑ ಪ್ರಚೋ॒ದಯಾ᳚ತ್ ॥"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ॒ಮಾಪೋ॒ ಜ್ಯೋತೀ॒ರಸೋ॒ಽಮೃತಂ॒ ಬ್ರಹ್ಮ॒ ಭೂರ್ಭುವ॒ಸ್ಸ್ವರೋಂ॥"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓಂ ಯದ॒ದ್ಯ ಕಚ್ಚ॑ ವೃತ್ರಹನ್ನು॒ದಗಾ᳚ ಅ॒ಭಿ ಸೂ᳚ರ್ಯ । ಸರ್ವಂ॒ ತದಿಂ᳚ದ್ರ ತೇ॒ ವಶೇ᳚ ॥\nಸೂರ್ಯ ಅಹಂ ಸೂರ್ಯಃ । ಅಸಾವಾದಿತ್ಯೋ ಬ್ರಹ್ಮ ॥"
    }
  ]
}
