{
  "id": "sayam_arghya_pradana",
  "blocks": [
    {
      "type": "heading",
      "text": "ಅರ್ಘ್ಯ ಪ್ರದಾನ"
    },
    {
      "type": "instruction",
      "text": "ಪಶ್ಚಿಮಾಭಿಮುಖವಾಗಿ ನಿ೦ತು"
    },
    {
      "type": "verse_sankalpa",
      "text": "ತತ್ಸವಿತುರ್ವಿಶ್ವಾಮಿತ್ರಸ್ಸವಿತಾಗಾಯತ್ರೀ"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ೦ ತತ್ಸ॑ವಿ॒ತುರ್ವರೇ᳚ಣ್ಯ॒೦ ಭರ್ಗೋ᳚ ದೇ॒ವಸ್ಯ॑ ಧೀಮಹಿ । ಧಿಯೋ॒ ಯೋ ನಃ॑ ಪ್ರಚೋ॒ದಯಾ᳚ತ್ ॥"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ॒ಮಾಪೋ॒ ಜ್ಯೋತೀ॒ರಸೋ॒ಽಮೃತ॒೦ ಬ್ರಹ್ಮ॒ ಭೂರ್ಭುವ॒ಸ್ಸ್ವರೋ೦॥"
    },
    {
      "type": "instruction",
      "text": "(೩ ಬಾರಿ)"
    },
    {
      "type": "verse_sankalpa",
      "text": "ಕಾಲಾತೀತ ದೋಷ ಪ್ರಾಯಶ್ಚಿತ್ತಾರ್ಥ೦ ಅರ್ಘ್ಯ ಪ್ರದಾನ೦ ಕರಿಷ್ಯೇ ।"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ೦ ತತ್ಸ॑ವಿ॒ತುರ್ವರೇ᳚ಣ್ಯ॒೦ ಭರ್ಗೋ᳚ ದೇ॒ವಸ್ಯ॑ ಧೀಮಹಿ । ಧಿಯೋ॒ ಯೋ ನಃ॑ ಪ್ರಚೋ॒ದಯಾ᳚ತ್ ॥"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ॒ಮಾಪೋ॒ ಜ್ಯೋತೀ॒ರಸೋ॒ಽಮೃತ॒೦ ಬ್ರಹ್ಮ॒ ಭೂರ್ಭುವ॒ಸ್ಸ್ವರೋ೦॥"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ೦ ಉದ್ಘೇದ॒ಭಿ ಶ್ರು॒ತಾಮ॑ಘ೦ ವೃಷ॒ಭ೦ ನರ್ಯಾ᳚ಪಸಮ್ । ಅಸ್ತಾ᳚ರಮೇಷಿ ಸೂರ್ಯ ॥ ಸೂರ್ಯ ಅಹ೦ ಸೂರ್ಯಃ ।ಅಸಾವಾದಿತ್ಯೋ ಬ್ರಹ್ಮ ॥"
    }
  ]
}
