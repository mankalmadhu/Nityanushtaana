{
  "id": "samidha_dana",
  "blocks": [
    {
      "type": "heading",
      "text": "ಸಮಿಧಾದಾನ"
    },
    {
      "type": "verse_sankalpa",
      "text": "ಅಗ್ನಯೇ ಸಮಿಧಮಿತ್ಯಸ್ಯ ಹಿರಣ್ಯಗರ್ಭಃ ಅಗ್ನಿಃ ಬೃಹತೀ ಸಮಿಧಾದಾನೇ ವಿನಿಯೋಗಃ ।"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓಂ ಅ॒ಗ್ನಯೇ᳚ ಸ॒ಮಿಧ॒ಮಾಹಾ᳚ರ್ಷಂ ಮಹ॒ತೇ ಜಾ॒ತವೇ᳚ದಸೇ ।\nತಯಾ॒ ತ್ವಮ॑ಗ್ನೇ॒ ವರ್ಧ॑ಸ್ವ ಸಮಿ॒ಧಾ ಬ್ರಹ್ಮ॑ಣಾ ವ॒ಯಂ ಸ್ವಾಹಾ᳚ ।"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಅಗ್ನಯೇ ಜಾತವೇದಸ ಇದಂ ನಮಮ ।"
    },
    {
      "type": "instruction",
      "text": "(ಹಸ್ತಂ ಪ್ರಕ್ಷಾಳ್ಯ)"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓಂ ತೇಜಸಾ ಮಾ ಸಮನಜ್ಮಿ ।"
    },
    {
      "type": "instruction",
      "text": "(ಮೂರು ಬಾರಿ)"
    }
  ]
}
