{
  "id": "samidha_dana",
  "blocks": [
    {
      "type": "heading",
      "text": "ಸಮಿಧಾದಾನ"
    },
    {
      "type": "verse_sankalpa",
      "text": "ಅಗ್ನಯೇ ಸಮಿಧಮಿತ್ಯಸ್ಯ ಹಿರಣ್ಯಗರ್ಭಃ ಅಗ್ನಿಃ ಬೃಹತೀ ಸಮಿಧಾದಾನೇ ವಿನಿಯೋಗಃ ।"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ೦ ಅ॒ಗ್ನಯೇ᳚ ಸ॒ಮಿಧ॒ಮಾಹಾ᳚ರ್ಷ೦ ಮಹ॒ತೇ ಜಾ॒ತವೇ᳚ದಸೇ ।\nತಯಾ॒ ತ್ವಮ॑ಗ್ನೇ॒ ವರ್ಧ॑ಸ್ವ ಸಮಿ॒ಧಾ ಬ್ರಹ್ಮ॑ಣಾ ವ॒ಯ೦ ಸ್ವಾಹಾ᳚ ।"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಅಗ್ನಯೇ ಜಾತವೇದಸ ಇದ೦ ನಮಮ ।"
    },
    {
      "type": "instruction",
      "text": "(ಹಸ್ತ೦ ಪ್ರಕ್ಷಾಳ್ಯ)"
    },
    {
      "type": "verse_viniyoga",
      "text": "ಓ೦ ತೇಜಸಾ ಮಾ ಸಮನಜ್ಮಿ ।"
    },
    {
      "type": "instruction",
      "text": "(ಮೂರು ಬಾರಿ)"
    }
  ]
}
